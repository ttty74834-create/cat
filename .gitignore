*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env/

# Coverage
.coverage
coverage/
htmlcov/

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/

# Gradle
.gradle/

# Compiled files
*.class
*.o
*.obj
*.out
*.exe
*.dll
*.so
*.a
*.jar
*.war
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
